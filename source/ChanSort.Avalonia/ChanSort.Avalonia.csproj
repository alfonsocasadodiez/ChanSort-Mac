<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Cross-platform user interface for macOS (and Linux), based on Avalonia UI.
    The Windows version continues to use the DevExpress WinForms UI in the "ChanSort" project.
  -->
  <Import Project="..\Solution.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ChanSort</AssemblyName>
    <RootNamespace>ChanSort.Avalonia</RootNamespace>
    <ApplicationIcon>..\ChanSort\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <Version>1.0.0</Version>
    <!-- loaders are found via reflection, so trimming must stay off -->
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>en;de;es;pl;pt;ro;ru;tr;hu;it;cs</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- sample reference lists, shared with the Windows UI -->
    <None Include="..\ChanSort\ReferenceLists\**" LinkBase="ReferenceLists" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChanSort.Api\ChanSort.Api.csproj" />
    <ProjectReference Include="..\ChanSort.Loader.Amdb\ChanSort.Loader.Amdb.csproj" />
    <ProjectReference Include="..\ChanSort.Loader.Android\ChanSort.Loader.Android.csproj" />
    <ProjectReference Include="..\ChanSort.Loader.Chmax\ChanSort.Loader.Chmax.csproj" />
    <ProjectReference Include="..\ChanSort.Loader.CmdbBin\ChanSort.Loader.CmdbBin.csproj" />
    <ProjectReference Include="..\ChanSort.Loader.DBM\ChanSort.Loader.DBM.csproj" />
    <ProjectReference Include="..\ChanSort.Loader.DvbViewer\ChanSort.Loader.DvbViewer.csproj" />
    <ProjectReference Include="..\ChanSort.Loader.Enigma2\ChanSort.Loader.Enigma2.csproj" />
